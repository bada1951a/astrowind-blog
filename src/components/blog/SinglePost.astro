---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Updated <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-pretty"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    
    <!-- 🛡️ 모바일 하위 p 태그 직격: prose-base [&>p]:text-[17px] [&>p]:leading-[1.75] / PC(lg 이상): 기존 시원한 prose-xl 유지 -->
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-base text-[17px] [&>p]:text-[17px] [&>p]:leading-[1.75] lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>

    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>

<script>
  function fixContentImages() {
    const content = document.querySelector('.prose');
    if (!content) return;

    // 1. Astro에 의해 <p> 태그 2개로 쪼개진 마크다운 이미지 문법 완벽 결합 및 교체
    const pElements = Array.from(content.querySelectorAll('p'));
    for (let i = 0; i < pElements.length; i++) {
      const p1 = pElements[i];
      const text1 = p1.textContent.trim();

      // 첫 번째 문단이 ![... 로 시작하는 경우
      if (text1.startsWith('![') && (text1.endsWith(']') || text1.endsWith(')'))) {
        let altText = text1.replace(/^!\[/, '').replace(/[\]\)]$/, '').trim();
        
        // 다음 문단이 (/images/tech-photo/...) 로 시작하는 경우
        if (i + 1 < pElements.length) {
          const p2 = pElements[i + 1];
          const text2 = p2.textContent.trim();
          
          if (text2.startsWith('(') && text2.endsWith(')') && text2.includes('/images/tech-photo/')) {
            const rawSrc = text2.slice(1, -1).trim();
            const cleanSrc = encodeURI(rawSrc);

            // 이미지 태그 생성 및 교체
            const imgP = document.createElement('p');
            imgP.className = 'my-6 text-center';
            imgP.innerHTML = `<img src="${cleanSrc}" alt="${altText}" class="mx-auto rounded-md shadow-lg max-w-full h-auto inline-block" />`;
            
            p1.parentNode.insertBefore(imgP, p1);
            p1.remove();
            p2.remove();
            i++; // p2까지 처리했으므로 건너뜀
            continue;
          }
        }
      }

      // 한 문단 안에 ![...](...)가 통째로 들어있는 경우 처리
      if (text1.startsWith('![') && text1.includes('/images/tech-photo/') && text1.endsWith(')')) {
        const match = text1.match(/^!\[(.*?)\]\s*\((.*?)\)$/);
        if (match) {
          const altText = match[1].trim();
          const cleanSrc = encodeURI(match[2].trim());
          p1.className = 'my-6 text-center';
          p1.innerHTML = `<img src="${cleanSrc}" alt="${altText}" class="mx-auto rounded-md shadow-lg max-w-full h-auto inline-block" />`;
        }
      }
    }
  }

  // 화면 렌더링 즉시 실행 (일반 로드 + Astro 페이지 이동 대응)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixContentImages);
  } else {
    fixContentImages();
  }
  document.addEventListener('astro:page-load', fixContentImages);
</script>
