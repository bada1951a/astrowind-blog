---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="py-8 sm:py-16 lg:py-20 mx-auto">
  <article>
    <header class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <div class="flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Updated <time datetime={post.updateDate.toISOString()}>{getFormattedDate(post.updateDate)}</time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
        </p>
      </div>

      <h1
        class="px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-pretty"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    <div
      class="mx-auto px-6 sm:px-6 max-w-3xl prose lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>
    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>
  </article>
</section>

<script>
  function fixContentImages() {
    // 1. 본문 영역만 타겟팅 (상단 대표 이미지는 절대 건드리지 않음)
    const content = document.querySelector('.prose');
    if (!content) return;

    // 2. 닫는 괄호가 ]든 )든 상관없이 본문에 노출된 텍스트를 정확히 잡아 img 태그로 치환
    const regex = /!\[([^\]\)\r\n]+)[\]\)]\s*\(\s*(\/images\/tech-photo\/[^\n\r]+?\.(?:png\vert{}jpe?g\vert{}webp\vert{}gif\vert{}avif))\s*\)/gi;
    
    if (regex.test(content.innerHTML)) {
      content.innerHTML = content.innerHTML.replace(regex, (match, alt, rawSrc) => {
        const cleanSrc = encodeURI(rawSrc.trim());
        return `<p class="my-6 text-center"><img src="${cleanSrc}" alt="${alt.trim()}" class="mx-auto rounded-md shadow-lg max-w-full h-auto inline-block" /></p>`;
      });
    }

    // 3. 본문(.prose) 내부의 img 태그만 안전하게 인코딩 보정
    content.querySelectorAll('img').forEach(img => {
      const src = img.getAttribute('src');
      if (src && src.startsWith('/images/tech-photo/') && (src.includes(' ') || src.includes('(') || src.includes(')'))) {
        img.src = encodeURI(src);
      }
    });
  }

  // 브라우저 로딩 및 Astro 페이지 전환 시 즉시 실행
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fixContentImages);
  } else {
    fixContentImages();
  }
  document.addEventListener('astro:page-load', fixContentImages);
</script>
