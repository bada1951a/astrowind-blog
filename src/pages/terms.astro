---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Terms of Service — Daily Insight',
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl text-default">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">Terms of Service</h1>
    <div class="prose dark:prose-invert max-w-none text-muted leading-relaxed space-y-6">
      <p>Last updated: October 13, 2026</p>

      <h2 class="text-xl font-semibold text-default mt-6">1. Terms</h2>
      <p>
        By accessing Daily Insight, you agree to comply with these terms of service, all applicable laws and
        regulations, and agree that you are responsible for compliance with any applicable local laws.
      </p>

      <h2 class="text-xl font-semibold text-default mt-6">2. Technical Disclaimer</h2>
      <p>
        The technical guides, troubleshooting articles, and advice provided on Daily Insight are intended for
        educational and informative purposes only. While every effort is made to ensure technical accuracy, procedures
        are executed at your own risk. Always ensure complete data backups before hardware or disk manipulation.
      </p>

      <h2 class="text-xl font-semibold text-default mt-6">3. Intellectual Property</h2>
      <p>
        All materials and publications contained on Daily Insight are protected by applicable copyright and trademark
        laws.
      </p>

      <h2 class="text-xl font-semibold text-default mt-6">4. Revisions & Errata</h2>
      <p>
        The materials appearing on Daily Insight may include technical, typographical, or photographic errors. We may
        make updates to materials at any time without prior notice.
      </p>
    </div>
  </section>
</Layout>
