---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About & Contact — Daily Insight',
  description: 'Learn more about Daily Insight, our mission, and how to get in touch with our editorial team.',
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl text-default">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight mb-8">About & Contact</h1>
    
    <div class="prose dark:prose-invert max-w-none text-muted leading-relaxed space-y-8">
      <div>
        <h2 class="text-2xl font-semibold text-default mb-3">About Daily Insight</h2>
        <p>
          Welcome to <strong>Daily Insight</strong>, an independent technical publication dedicated to demystifying modern hardware, IT infrastructure, and system diagnostics.
        </p>
        <p>
          Our team comprises seasoned IT engineers and tech enthusiasts sharing real-world troubleshooting workflows, practical hardware teardowns, and actionable operating system guides. We believe in high-utility, verified solutions that save time and prevent critical data loss.
        </p>
      </div>

      <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
        <h2 class="text-2xl font-semibold text-default mb-3">Editorial Standards & Ethics</h2>
        <p>
          All guides published on Daily Insight undergo rigorous practical testing. We adhere to transparent technical reporting, prioritizing data safety, standardized testing environments, and authentic troubleshooting experiences.
        </p>
      </div>

      <div class="border-t border-gray-200 dark:border-gray-800 pt-6">
        <h2 class="text-2xl font-semibold text-default mb-3">Contact Us</h2>
        <p>
          Have questions, technical feedback, errata submissions, or partnership inquiries? We value our readers' insights and strive to respond to all inquiries within 2-3 business days.
        </p>
        <div class="mt-4 p-4 rounded-lg bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-gray-700">
          <p class="font-medium text-default mb-1">Direct Editorial Inquiries:</p>
          <p class="text-primary font-mono font-semibold">contact@storydailyview.com</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
