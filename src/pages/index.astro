---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

const metadata = {
  title: '데일리 인사이트 — 매일 만나는 알짜 핫이슈와 정보 큐레이션',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 히어로 소개 영역 -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: '최신 글 전체보기',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
  >
    <Fragment slot="title">
      매일 만나는 알짜 정보와 인사이트, <br />
      <span class="text-accent dark:text-white highlight">데일리 인사이트</span>
    </Fragment>

    <Fragment slot="subtitle">
      트렌드 핫이슈부터 실생활 꿀팁, IT 및 테크 리뷰까지 꼭 필요한 알짜 지식만 모아 전달합니다.
    </Fragment>
  </Hero>

  <!-- 최신 블로그 포스트 카드 목록 -->
  <BlogLatestPosts
    title="최신 포스팅 둘러보기"
    information="데일리 인사이트에서 엄선한 최신 아티클을 확인해 보세요."
  />
</Layout>