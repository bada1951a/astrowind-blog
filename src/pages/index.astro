---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';

// JPG로 저장하셨다면:
import heroImage from '~/assets/images/satellite-earth.jpg';

const metadata = {
  title: 'Daily Insight — Practical Tech Insights & Troubleshooting Guides',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Explore Articles',
        href: '/blog',
        icon: 'tabler:chevron-right',
      },
    ]}
  >
    <Fragment slot="title">
      Daily Practical Tech Insights,<br />
      <span class="text-accent dark:text-white highlight">Daily Insight</span>
    </Fragment>

    <Fragment slot="subtitle">
      From trending IT topics to in-depth hardware troubleshooting and practical tech guides.
    </Fragment>
  </Hero>

  <!-- Latest Posts Section -->
  <BlogLatestPosts
    title="Latest Articles"
    information="Explore carefully selected technical guides and troubleshooting tutorials."
    count={6}
  />
</Layout>
